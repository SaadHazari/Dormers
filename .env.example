# ============================================================================
# Dormers — environment variables required to run the app
#
# Copy this file to `.env.local` (gitignored) and fill in real values from the
# project owner. The keys grouped under "Phase 7" became required when the
# Dorm Wars reward backend shipped — without SUPABASE_SERVICE_ROLE_KEY, the
# awarder + daily-drop + streak endpoints will all 500.
# ============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL + the publishable (anon) key are safe to ship to the browser
# (NEXT_PUBLIC_ prefix). The service-role key MUST stay server-only — it
# bypasses RLS and can read/write any row in any table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY signs every Checkout Session create + Coupon create.
# STRIPE_WEBHOOK_SECRET verifies inbound webhook signatures (rejects forgeries).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── WhatsApp OTP (Meta Cloud API) ─────────────────────────────────────────
# Used by /api/whatsapp/start + /api/whatsapp/check via infra/meta-whatsapp.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# ── Email (Supabase Auth) ─────────────────────────────────────────────────
# Email OTPs come from Supabase Auth's built-in mailer using the Magic Link
# template configured in Dashboard → Auth → Email Templates. The template
# must include `{{ .Token }}` for the 6-digit code (Auth → Email OTP length).
# No app-level env vars needed; configured entirely in the Supabase dashboard.

# ── Base URL (Stripe redirect, magic-link callbacks) ──────────────────────
# Stripe success_url + Supabase emailRedirectTo both honor this.
NEXT_PUBLIC_BASE_URL=https://dormers.ae

# ── Admin allowlist (/admin/* routes) ─────────────────────────────────────
# Comma-separated email addresses (case-insensitive). Anyone NOT in this list
# is redirected to /dashboard when visiting /admin/* — including the Layer 4
# review queue (manual verification of Google review claims, etc.). Empty /
# unset = no admins, all admin routes locked. Set on Netlify env too.
ADMIN_EMAILS=

# ── Gemini / Google Generative AI (chat + Google review verification) ────
# Used by /api/chat (homepage chatbot) AND /api/dorm-wars/layer4/google-review
# (Gemini Vision verifies uploaded review screenshots). Same model, same key.
# Get from https://aistudio.google.com/apikey.
GOOGLE_GENERATIVE_AI_API_KEY=
