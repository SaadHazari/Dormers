# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but DO track the example template — it holds no secrets and CI's
# tier3-audit-fixes.test.ts reads it (CI was failing on ENOENT because the file
# was gitignored and therefore absent in the checkout).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude worktrees (embedded repos break Netlify)
.claude/worktrees/

# Local agent / Claude skill catalogues — sourced from external repos for
# the local agents only; not part of the deployed app.
.agents/skills/
.claude/skills/

# Bug-hunter agent scratch output — regenerable findings/reports, not app code.
.bug-hunter/

# System-map render artefacts: regenerable screenshots, the superseded
# LaTeX experiment, and the puppeteer renderer's own node_modules.
docs/system-map/_screenshots/
docs/system-map/_archive_latex/
docs/system-map/node_modules/

# Local Netlify folder
.netlify

# Supabase CLI scratch
supabase/.temp/

# Personal secrets — never commit
Backup-codes-*.txt

# Raw box photos — only the downscaled output in box-reference/ is committed
box-reference/source/

# Scratch output from the playwright-cli tooling
.playwright-cli/
